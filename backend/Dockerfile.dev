# Varianta de dezvoltare: acelasi mediu ca Dockerfile, plus reincarcare la salvare.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# tesseract: OCR-ul care citeste CNP-ul de pe buletin (ron = limba romana).
# libgl1 + libglib2.0-0: cerute de opencv, pe care il foloseste DeepFace.
RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr \
      tesseract-ocr-ron \
      libgl1 \
      libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependintele se citesc din pyproject.toml, la fel ca in imaginea de productie:
# doua liste care pot ajunge sa difere sunt mai rele decat una singura.
COPY pyproject.toml ./
COPY app ./app
RUN pip install --upgrade pip && pip install -e ".[dev]"

# Descarca greutatile ArcFace la build, nu la prima cerere de verificare identitate.
RUN python -c "from deepface import DeepFace; DeepFace.build_model('ArcFace')"

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
