APP_ENV=development
LOG_LEVEL=INFO
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=

# Cheie privilegiata: trece peste RLS. Numai server, niciodata in frontend.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000

# Layer-ul de agenti. Fara endpoint si cheie, /api/v1/agents/chat raspunde 503;
# /api/v1/alerte merge oricum, nu trece prin niciun model.
LLM_PROVIDER=azure
# key = cheia din .env (merge si in container). identity = Entra.
AZURE_AI_AUTH=key
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Verificarea de identitate la inregistrare (buletin OCR + selfie).
# Secret partajat doar intre serverul Next.js si acest serviciu, pentru fereastra
# de dupa signUp() in care inca nu exista sesiune Supabase. Lasat gol, calea cu
# cheie interna ramane inchisa si merge doar autentificarea prin JWT.
BACKEND_INTERNAL_API_KEY=
# Optional — lasa nesetat ca sa foloseasca pragul implicit ArcFace din DeepFace.
# IDENTITY_VERIFY_DISTANCE_THRESHOLD=0.68
