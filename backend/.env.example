# Copiaza in .env si completeaza doar credentialele (marcate mai jos). Restul
# valorilor sunt cele reale, deja folosite — nu au nevoie de schimbat.
# .env nu se comite (vezi .gitignore).

ENVIRONMENT=local

# --- Supabase -----------------------------------------------------------
# Dashboard -> Project Settings -> API Keys. Foloseste cheia "secret"
# (sb_secret_...), NU "publishable" (sb_publishable_...) — doar cea secreta
# ocoleste RLS. Publishable e deja in frontend/.env (NEXT_PUBLIC_SUPABASE_ANON_KEY).
# Fara SUPABASE_JWT_SECRET: verificarea token-urilor se face prin JWKS
# (/auth/v1/.well-known/jwks.json, derivat din SUPABASE_URL), nu printr-un
# secret HS256 partajat — proiectele Supabase noi semneaza cu ES256.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft Foundry (chat + embeddings) -------------------------------
# Endpoint-ul e cel din blade-ul "Models" al resursei Foundry, forma
# https://<resursa>.openai.azure.com/models — folosit direct ca base_url cu
# clientul OpenAI simplu (nu AsyncAzureOpenAI, care raspunde 404 pe acest tip
# de resursa — verificat live).
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# gpt-5-mini e model de reasoning: tokenii de reasoning se scad din acelasi
# buget ca raspunsul vizibil, deci bugetul trebuie sa fie generos. Nu exista
# variabila de temperature: modelul respinge orice valoare in afara celei
# implicite (400 unsupported_value).
AZURE_FOUNDRY_MAX_COMPLETION_TOKENS=2000

# Schimba doar daca redeployezi embeddingurile sub alt model/versiune —
# vezi app/rag/indexing.py (embedding_key izoleaza spatiile de vectori).
LIBRA_EMBEDDING_VERSION=v1

# --- Agent vocal (Azure AI Speech) ---------------------------------------
# Resursa Speech separata de Foundry, din acelasi tenant Azure.
# REST-ul foloseste domeniul regional (<regiune>.stt/tts.speech.microsoft.com);
# endpoint-ul de resursa (cognitiveservices.azure.com) raspunde 404 pe caile
# astea, verificat live — de-asta regiunea are prioritate in providers/voice.py.
# Regiunea (ex. "francecentral") e obligatorie; endpoint-ul e optional.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
# Voce multilingva — vorbeste corect si RO si EN, potrivit pentru un asistent bilingv.
AZURE_SPEECH_VOICE_NAME=en-US-AvaMultilingualNeural

# Nefolosit inca de cod — pastrat pentru cand se adauga integrare cu Azure
# Monitor / diagnostic settings pe resursa Foundry. Optional.
AZURE_RESOURCE_ID=

# --- Atasamente in chat (PDF / poze) --------------------------------------
LIBRA_ATTACHMENTS_BUCKET=asistent-atasamente
LIBRA_MAX_ATTACHMENT_BYTES=10485760

# --- Cost tracking (docs/AI_ARCHITECTURE.md #10) --------------------------
LIBRA_AI_CHAT_PRICE_PER_MILLION_INPUT=0.25
LIBRA_AI_CHAT_PRICE_PER_MILLION_OUTPUT=2.00

# --- Baza de cunostinte (RAG) ---------------------------------------------
# Gol = repo_root/galaxy-bank-knowledge (calculat automat). In Docker Compose
# e suprascris la /galaxy-bank-knowledge (vezi docker-compose.yml).
LIBRA_KNOWLEDGE_DIR=

# --- Verificare identitate (OCR buletin + DeepFace selfie) ----------------
# Secret partajat DOAR intre serverul Next.js si acest serviciu — folosit cand
# nu exista inca o sesiune Supabase (inregistrare cu confirmare pe email
# activata). Nu ajunge niciodata in browser. Genereaza o valoare lunga random.
BACKEND_INTERNAL_API_KEY=
# Gol = pragul implicit al modelului ArcFace din DeepFace.
IDENTITY_VERIFY_DISTANCE_THRESHOLD=
IDENTITY_DEEPFACE_MODEL=ArcFace
IDENTITY_DETECTOR_BACKEND=yunet

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Variabile dintr-un alt proiect — nu sunt citite de niciun modul din
# app/core/config.py inca (grep "app/core/config.py" e singurul loc care are
# voie sa citeasca environment-ul, deci orice nefolosit aici e garantat mort
# pana nu se implementeaza explicit). Pastrate neatinse, ca sa nu se piarda
# nimic, dar inainte de implementare trebuie clarificat ce ar trebui sa faca
# fiecare grup — unele contrazic decizii deja luate (cache de embeddinguri in
# Postgres/pgvector, nu SQLite; compresie determinista fara apel LLM, nu
# "semantic-compaction").
# =============================================================================

# --- persistent conversation memory ----------------------------------------
HISTORY_MAX_MESSAGES=16
HISTORY_MAX_TOKENS=10000
SESSION_SUMMARY_MAX_CHARS=4000
SESSION_COMPACTION_BATCH_MESSAGES=4
SHARED_MEMORY_MAX_CHARS=5000
SHARED_MEMORY_SESSION_LIMIT=4
SHARED_MEMORY_CANDIDATE_LIMIT=24
SHARED_MEMORY_MIN_SCORE=0.18
SHARED_MEMORY_LEXICAL_OVERRIDE=0.20

# Persistent SQLite vector cache. The provider/model are part of every cache key.
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_PATH=runtime/embedding_cache.sqlite3
EMBEDDING_CACHE_MAX_ENTRIES=20000

# --- pricing, search and managed retrieval defaults -------------------------
AZURE_GPT5_MINI_INPUT_PRICE=0.25
AZURE_GPT5_MINI_CACHED_INPUT_PRICE=0.025
AZURE_GPT5_MINI_OUTPUT_PRICE=2.00

SEARCH_PROVIDER=auto
SEARCH_API_KEY=
WEB_SEARCH_RESULTS=5
FACT_CHECK_PAGES=3

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=libra-docs
AZURE_SEARCH_KEY=
GROUNDING_GUARDRAIL_LLM_ENABLED=true
GROUNDING_GUARDRAIL_FAIL_CLOSED=false
GROUNDING_GUARDRAIL_MAX_TOKENS=1800

# --- chunking defaults (every request may override them) -------------------
# strategies: static | dynamic | sentence | semantic
CHUNK_STRATEGY=dynamic
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SENTENCES_PER_CHUNK=3
SEMANTIC_THRESHOLD=0.75

# --- retrieval / generation defaults ---------------------------------------
TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.30
RETRIEVAL_CANDIDATE_POOL=10
RETRIEVAL_VECTOR_WEIGHT=0.75
RETRIEVAL_DUPLICATE_THRESHOLD=0.82
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_CHARS=120000
