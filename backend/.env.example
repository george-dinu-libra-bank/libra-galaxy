APP_ENV=development
LOG_LEVEL=INFO

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Cheia publica: cu ea se construieste clientul per-utilizator, deci RLS ramane
# bariera din baza de date.
SUPABASE_ANON_KEY=
# Cheie privilegiata: trece peste RLS. Numai server, niciodata in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Secret partajat doar cu serverul Next.js, pentru fereastra dintre signUp() si
# prima sesiune (cand confirmarea pe email e activata).
BACKEND_INTERNAL_API_KEY=

# Se accepta si CORS_ORIGINS, pentru .env-urile scrise inainte de unificare.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Verificare identitate (buletin OCR + selfie DeepFace) -------------------
# Optional — lasa nesetat ca sa foloseasca pragul implicit ArcFace din DeepFace.
# Atentie: e o DISTANTA, nu o similaritate. Mai mic inseamna mai asemanator,
# iar potrivirea trece cand distanta <= prag.
# IDENTITY_VERIFY_DISTANCE_THRESHOLD=0.68

# --- Layerul de agenti ------------------------------------------------------
# Fara endpoint si cheie, /api/v1/agents/chat raspunde 503;
# /api/v1/alerte merge oricum, nu trece prin niciun model.
LLM_PROVIDER=azure
# key = cheia din .env (merge si in container). identity = Entra.
AZURE_AI_AUTH=key
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
