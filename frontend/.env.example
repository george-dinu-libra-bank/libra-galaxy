# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheia service_role NU se expune in browser. Se foloseste doar in cod de server.
SUPABASE_SERVICE_ROLE_KEY=

# URL intern pentru Server Components in Docker. In afara Docker poate lipsi.
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321

# Optional: URL-ul public al aplicatiei, folosit in linkurile din emailurile Supabase.
# In dezvoltare se deduce automat din header-ele requestului.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend-ul este accesat numai server-side, prin route handler-ul /api/backend/*.
BACKEND_INTERNAL_URL=http://localhost:8000
