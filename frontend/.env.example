# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheia service_role NU se expune in browser. Se foloseste doar in cod de server.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: URL-ul public al aplicatiei, folosit in linkurile din emailurile Supabase.
# In dezvoltare se deduce automat din header-ele requestului.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend-ul propriu (src/lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000
