FROM node:22-alpine

WORKDIR /app

# Dependintele se instaleaza in imagine; node_modules e montat ca volum anonim
COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 3000
# --webpack: Turbopack nu suporta watch prin polling, iar pe bind mount de
# Windows evenimentele inotify nu ajung in container. Webpack + WATCHPACK_POLLING
# detecteaza modificarile.
CMD ["npm", "run", "dev", "--", "--webpack", "-H", "0.0.0.0", "-p", "3000"]
