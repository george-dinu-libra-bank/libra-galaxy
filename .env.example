# Singura sursa de credentiale a proiectului — backend si frontend citesc
# amandoua de aici (backend prin core/config.py, frontend prin
# frontend/src/lib/env.ts). Copiaza in .env si completeaza doar valorile
# lipsa. .env nu se comite (vezi .gitignore).
#
# Restul variabilelor (nume de deployment, bugete de tokeni, praguri, CORS
# etc.) NU stau aici — au valori implicite corecte in cod
# (backend/app/core/config.py) si se suprascriu doar daca chiar e nevoie,
# adaugand cheia respectiva local.

REACT_EDITOR=atom
# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> API Keys.
# SUPABASE_SERVICE_ROLE_KEY = cheia "secret" (sb_secret_...) — ocoleste RLS,
# NU se expune niciodata catre browser.
# SUPABASE_ANON_KEY = cheia "publishable" (sb_publishable_...) — ajunge in
# browser (frontend o re-expune ca NEXT_PUBLIC_SUPABASE_ANON_KEY, aliasat la
# nivel de docker-compose, nu duplicat aici).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Microsoft Foundry (chat + embeddings) ---------------------------------
# Sursa unica de credentiale Azure pentru tot ce vorbeste cu modelul —
# providers/foundry.py (transaction_intelligence, document_intelligence,
# engagement, RAG) SI financial advisor-ul lui Cristi (agents/financiar.py,
# SDK diferit — azure-ai-inference — dar aceeasi resursa). Nu mai exista
# AZURE_AI_ENDPOINT/AZURE_AI_API_KEY separate (decizie explicita).
# Endpoint-ul e cel din blade-ul "Models" al resursei Foundry, forma
# https://<resursa>.openai.azure.com/models.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# --- Azure AI Speech (agent vocal) -----------------------------------------
# Resursa Speech separata de Foundry, din acelasi tenant Azure. Regiunea
# (ex. "francecentral") e obligatorie; endpoint-ul e optional.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
# Vocea TTS implicita e "ro-RO-AlinaNeural" (core/config.py) — suprascrie
# doar daca vrei alta voce Azure.
AZURE_SPEECH_VOICE_NAME=

# --- Azure AI Document Intelligence (OCR pe adeverinte de venit) ------------
# Resursa "Document Intelligence" / "Form Recognizer" din portal, separata de
# Foundry si de Speech. Portal -> resursa -> Keys and Endpoint.
#
# Endpoint-ul are forma https://<resursa>.cognitiveservices.azure.com/ — copiaza
# exact ce scrie in campul "Endpoint". Daca lipesti unul care se termina deja in
# /formrecognizer/ sau /documentintelligence/, calea se dubleaza si primesti 404.
#
# Azure da doua chei, KEY 1 si KEY 2, pentru ACEEASI resursa: exista ca sa le
# poti roti fara sa pice serviciul. Pune una singura aici; a doua o tii pe
# portal ca rezerva, nu in fisier.
#
# Cat timp sunt goale, OCR-ul cade pe Tesseract din container si totul merge mai
# departe — vezi infrastructure/document_text.py.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Modelul implicit e "prebuilt-read" (core/config.py) — suprascrie doar daca
# chiar vrei altul. "prebuilt-layout" costa de ~7 ori mai mult si nu ne aduce
# nimic: parserul din credit/adeverinta.py lucreaza pe text, nu pe structura de
# tabel.
AZURE_DOCUMENT_INTELLIGENCE_MODEL=

# --- Secret partajat Next.js <-> FastAPI -----------------------------------
# Folosit doar in fereastra de dupa signUp(), cand inca nu exista sesiune
# Supabase (verificare identitate la inregistrare). Nu ajunge niciodata in
# browser. Genereaza o valoare lunga random.
BACKEND_INTERNAL_API_KEY=

# --- Doar pentru Supabase local prin CLI (scripts/dev-up.ps1) -------------
# Lasat gol implicit — dev-up.ps1 il seteaza dinamic din `supabase status`.
# Completeaza-l manual doar daca rulezi Supabase local fara acel script.
SUPABASE_INTERNAL_URL=
