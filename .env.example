# Proiectul Supabase folosit de docker compose.
#
# Pentru Supabase LOCAL nu ai nevoie de acest fisier: scripts/dev-up.ps1 pune
# valorile in mediu, iar mediul are prioritate fata de .env.
#
# Pentru Supabase CLOUD completeaza tot si porneste cu scripts/dev-up-cloud.ps1.
# Valorile sunt in Supabase: Project Settings > API.

# URL-ul proiectului, ex. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Acelasi URL. Difera de cel de sus doar la Supabase local, unde containerele
# folosesc host.docker.internal in loc de localhost.
SUPABASE_INTERNAL_URL=
# Cheia publishable / anon. Ajunge in browser, deci nu e secreta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Layer-ul de agenti (optional). Fara ea, /api/v1/agents raspunde 503.
ANTHROPIC_API_KEY=

# Cheia service_role NU se pune aici. Locul ei e backend/.env.
