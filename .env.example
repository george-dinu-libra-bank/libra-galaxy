# Singura sursa de credentiale a proiectului — backend si frontend citesc
# amandoua de aici (backend prin core/config.py, frontend prin
# frontend/src/lib/env.ts). Copiaza in .env si completeaza doar valorile
# lipsa. .env nu se comite (vezi .gitignore).
#
# Restul variabilelor (nume de deployment, bugete de tokeni, praguri, CORS
# etc.) NU stau aici — au valori implicite corecte in cod
# (backend/app/core/config.py) si se suprascriu doar daca chiar e nevoie,
# adaugand cheia respectiva local.

# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> API Keys.
# SUPABASE_SERVICE_ROLE_KEY = cheia "secret" (sb_secret_...) — ocoleste RLS,
# NU se expune niciodata catre browser.
# SUPABASE_ANON_KEY = cheia "publishable" (sb_publishable_...) — ajunge in
# browser (frontend o re-expune ca NEXT_PUBLIC_SUPABASE_ANON_KEY, aliasat la
# nivel de docker-compose, nu duplicat aici).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Microsoft Foundry (chat + embeddings, backend/app/providers/foundry.py) --
# Endpoint-ul e cel din blade-ul "Models" al resursei Foundry, forma
# https://<resursa>.openai.azure.com/models.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# --- Financial advisor (backend/app/agents/financiar.py) ------------------
# Bucla proprie de tool-calling peste azure-ai-inference — SDK diferit de cel
# de mai sus, dar de obicei aceeasi resursa/endpoint Foundry.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

# --- Azure AI Speech (agent vocal) -----------------------------------------
# Resursa Speech separata de Foundry, din acelasi tenant Azure. Regiunea
# (ex. "francecentral") e obligatorie; endpoint-ul e optional.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# --- Secret partajat Next.js <-> FastAPI -----------------------------------
# Folosit doar in fereastra de dupa signUp(), cand inca nu exista sesiune
# Supabase (verificare identitate la inregistrare). Nu ajunge niciodata in
# browser. Genereaza o valoare lunga random.
BACKEND_INTERNAL_API_KEY=

# --- Doar pentru Supabase local prin CLI (scripts/dev-up.ps1) -------------
# Lasat gol implicit — dev-up.ps1 il seteaza dinamic din `supabase status`.
# Completeaza-l manual doar daca rulezi Supabase local fara acel script.
SUPABASE_INTERNAL_URL=
